# Example environment file for LLaMEA Benchmark
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Alternative API Key (for custom endpoints)
AIML_KEY=your_custom_api_key_here

# Custom Base URL (for custom OpenAI-compatible endpoints)
BASE_URL=https://api.your-custom-endpoint.com/v1

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Example usage:
# python llamea_benchmark.py --llm openai --model gpt-4-turbo --budget 50
# python llamea_benchmark.py --llm openai --model your-custom-model --budget 50
